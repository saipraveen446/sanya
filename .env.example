# Supabase session pooler (IPv4, works in Docker). Direct db.*.supabase.co is often IPv6-only.
# User must be postgres.PROJECT_REF on the pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Direct (IPv6): postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Local Docker Postgres:
# DATABASE_URL=postgresql://expense:expense@db:5432/expenses

# Telegram
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# Which skill handles a message when routing is unsure
DEFAULT_SKILL=expense_tracking

# Preferred LLM. Tried first when its API key is set.
# gemini | groq | openrouter | openai | auto
# If that key is empty or the call fails, fallback is:
# gemini → groq → openrouter → openai (best free first, paid last).
DEFAULT_LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Paid fallback, used after the free providers above.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stop Python from writing __pycache__ next to source files
PYTHONDONTWRITEBYTECODE=1

APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
